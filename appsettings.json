{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  #{{normalDbConfig}}
  "Database": {
    "Host": "localhost",
    "Database": "${{projectName}}",
    "Username": "root",
    "Password": ""
  },
  #{{normalDbConfig/}}
  #{{sqliteDbConfig}}
  "Database": "${{projectName}}.db",
  #{{sqliteDbConfig/}}
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}